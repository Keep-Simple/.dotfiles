{
  "neodev": {
    "library": {
      "enabled": true,
      "plugins": true
    }
  },
  "neoconf": {
    "plugins": {
      "lua_ls": {
        "enabled": true
      },
      "lspconfig": {
        "enabled": true
      }
    }
  },
  "lspconfig": {
    "basedpyright": {
      "basedpyright.disableOrganizeImports": true,
      "basedpyright.analysis.typeCheckingMode": "basic",
      "basedpyright.analysis.diagnosticMode": "workspace"
    }
  }
}
