{
  "nativeMCPServers": [
    
  ],
  "mcpServers": {
    "sequential-thinking": {
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "custom_instructions": {
        "text": ""
      }
    },
    "github": {
      "command": "npx",
      "disabled": false,
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "git": {
      "disabled": false,
      "args": [
        "mcp-server-git"
      ],
      "command": "uvx"
    },
    "playwright": {
      "disabled": false,
      "args": [
        "@playwright/mcp@latest",
        "--executable-path",
        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
        "--vision"
      ],
      "command": "npx"
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "command": "uvx"
    }
  }
}
