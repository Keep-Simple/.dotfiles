#!/usr/bin/env bash
# Back up / restore Claude Code conversation transcripts for every repo.
# Transcripts live in ~/.claude/projects/<abs-repo-path with / and . as ->/*.jsonl
# plus ~/.claude/history.jsonl, so an archive only lands correctly on a machine
# with the same $HOME and repo paths; restore warns when the prefix differs.
set -uo pipefail

root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

usage() {
  echo "usage: claude-transcripts backup [out.zip]" >&2
  echo "       claude-transcripts restore <archive.zip>" >&2
  exit 2
}

case "${1:-}" in
backup)
  [ -d "$root/projects" ] || { echo "claude-transcripts: no transcripts at $root/projects" >&2; exit 1; }
  out="${2:-$HOME/claude-transcripts-$(date +%Y%m%d-%H%M%S).zip}"
  mkdir -p "$(dirname "$out")" || exit 1
  out="$(cd "$(dirname "$out")" && pwd)/$(basename "$out")"
  rm -f "$out"
  (cd "$root" && zip -qr "$out" projects $([ -f history.jsonl ] && echo history.jsonl)) || exit 1
  echo "claude-transcripts: wrote $out ($(du -h "$out" | cut -f1), $(find "$root/projects" -name '*.jsonl' | wc -l | tr -d ' ') sessions)"
  ;;
restore)
  archive="${2:-}"
  [ -f "$archive" ] || usage
  prefix="$(printf '%s' "$HOME" | tr '/.' '-')"
  # No pipe into grep here: pipefail would see unzip's SIGPIPE as a failure.
  case "$(unzip -Z1 "$archive")" in
  *"projects/$prefix"*) ;;
  *) echo "claude-transcripts: warning - archive was made under a different \$HOME (expected dirs like projects/$prefix); sessions restore but /resume won't list them" >&2 ;;
  esac
  mkdir -p "$root" || exit 1
  unzip -oq "$archive" -d "$root" || exit 1
  echo "claude-transcripts: restored into $root (existing history.jsonl overwritten)"
  ;;
*)
  usage
  ;;
esac
