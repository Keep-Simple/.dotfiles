#!/bin/sh

# Update bmad-method skills in multiple project directories in parallel.
# Requires: npm install -g bmad-method
#
# Usage:
#   bmad-update ~/project1 ~/project2 ~/project3
#   bmad-update --modules bmm,bmb ~/project1 ~/project2

set -e

modules="bmm"
tools="claude-code"
dirs=""

# Parse args
while [ $# -gt 0 ]; do
    case "$1" in
        --modules)
            modules="$2"
            shift 2
            ;;
        --tools)
            tools="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: bmad-update [--modules bmm,bmb] [--tools claude-code] <dir1> [dir2] ..."
            echo ""
            echo "Update bmad-method in multiple projects in parallel."
            echo "Requires: npm install -g bmad-method"
            echo ""
            echo "Options:"
            echo "  --modules   Comma-separated module list (default: bmm)"
            echo "  --tools     Comma-separated tool list (default: claude-code)"
            echo "  -h, --help  Show this help"
            exit 0
            ;;
        *)
            dirs="$dirs $1"
            shift
            ;;
    esac
done

if [ -z "$dirs" ]; then
    echo "Error: no directories specified"
    echo "Usage: bmad-update <dir1> [dir2] ..."
    exit 1
fi

if ! command -v bmad >/dev/null 2>&1; then
    echo "Error: bmad not found. Run: npm install -g bmad-method"
    exit 1
fi

bmad_version() {
    npm list -g bmad-method --depth=0 2>/dev/null | awk -F@ '/bmad-method/ {print $NF}' | head -1
}

old_ver=$(bmad_version)
echo "Updating bmad-method global package..."
npm update -g bmad-method
new_ver=$(bmad_version)
if [ "$old_ver" = "$new_ver" ]; then
    echo "bmad-method: $new_ver (unchanged)"
else
    echo "bmad-method: $old_ver -> $new_ver"
fi
echo ""

# Clear external module cache to avoid parallel git clone races
rm -rf "$HOME/.bmad/cache/external-modules" 2>/dev/null

logdir=$(mktemp -d)
total=0
pids=""

for dir in $dirs; do
    dir=$(eval echo "$dir") # expand ~
    if [ ! -d "$dir" ]; then
        echo "SKIP $dir (not a directory)"
        continue
    fi

    total=$((total + 1))
    logfile="$logdir/$(echo "$dir" | tr '/' '_').log"

    echo "START $dir"
    bmad install \
        --directory "$dir" \
        --modules "$modules" \
        --tools "$tools" \
        --action quick-update \
        --yes \
        > "$logfile" 2>&1 &

    pids="$pids $!:$dir"
done

if [ $total -eq 0 ]; then
    echo "No valid directories to update"
    rm -rf "$logdir"
    exit 1
fi

# Wait for all and collect results
succeeded=0
failed=0
failed_dirs=""

for entry in $pids; do
    pid="${entry%%:*}"
    dir="${entry#*:}"
    logfile="$logdir/$(echo "$dir" | tr '/' '_').log"

    if wait "$pid"; then
        echo "  OK $dir"
        succeeded=$((succeeded + 1))
    else
        echo "FAIL $dir"
        cat "$logfile" | sed 's/^/     /'
        failed=$((failed + 1))
        failed_dirs="$failed_dirs $dir"
    fi
done

echo ""
echo "$succeeded/$total succeeded"
if [ $failed -gt 0 ]; then
    echo "$failed failed:$failed_dirs"
fi

rm -rf "$logdir"
[ $failed -eq 0 ]
