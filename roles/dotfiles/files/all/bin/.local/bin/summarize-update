#!/usr/bin/env bash
# Per-tool log summarizer for `my update`. Reads log on stdin, prints one line.
# Usage: summarize-update <tool> [delta] [status]
set -u

tool="${1:-?}"
delta="${2:-?}"
status="${3:-OK}"

strip() { sed $'s/\x1b\\[[0-9;]*m//g' | tr -d '\r'; }

case "$tool" in
  brew)
    body=$(awk '
      /^==> Upgrading [0-9]+ outdated/ { n=$3 }
      /^==> Upgrading / && /->/ {
        gsub(/,/, ""); pkgs = pkgs sep $3 " " $4 "→" $6; sep = ", "
      }
      /Already up-to-date/ { up=1 }
      END {
        if (n) print "updated " n ": " pkgs
        else if (up) print "0 outdated"
        else print "no changes"
      }')
    ;;

  tpm)
    body=$(awk '
      /update success/ { ok++ }
      /Already up to date/ { noop++ }
      /update fail/ { fail++ }
      END {
        changed = ok - (noop > ok ? ok : noop - 1)
        if (changed < 0) changed = 0
        printf "%d plugins, %d changed", ok, changed
        if (fail) printf ", %d failed", fail
        print ""
      }')
    ;;

  asdf)
    body=$(awk '
      /^updated / { n++ }
      END { print n " plugin repos refreshed (no tool version changes)" }')
    ;;

  bmad)
    body=$(awk '
      /^bmad-method: .* -> / { ver = $2 " → " $4 }
      /^bmad-method: .* \(unchanged\)/ { ver = $2 " (unchanged)" }
      /^[ ]+OK / { ok++ }
      /^[ ]+FAIL / { fail++ }
      /^[0-9]+\/[0-9]+ succeeded/ { tot=$1 }
      END {
        printf "bmad-method %s; repos %s", (ver ? ver : "?"), (tot ? tot : ok"/"ok+fail)
        if (fail) printf " (%d failed)", fail
        print ""
      }')
    ;;

  yazi)
    body=$(awk '
      /^  Upgrading package/ { tot++; gsub(/`/, ""); cur=$3 }
      /^Done!/ { done++ }
      /aborted/ { bad++; aborts = aborts (aborts ? ", " : "") cur }
      END {
        printf "%d packages, %d done", tot, done
        if (bad) printf ", %d aborted (%s)", bad, aborts
        print ""
      }')
    ;;

  claude)
    body=$(strip | awk '
      /Plugin .* updated from/ {
        sub(/.*Plugin "/, ""); sub(/" .*/, "")
        upd++; names = names (names ? ", " : "") $0
      }
      /already at the latest version/ { ok++ }
      /Failed to refresh marketplace/ { warn = "; marketplace refresh failed" }
      /^✖ / { fail++ }
      END {
        printf "%d/%d updated", upd, upd + ok
        if (upd) printf " (%s)", names
        if (warn) printf "%s", warn
        if (fail) printf "; %d errors", fail
        print ""
      }')
    ;;

  zinit)
    body=$(strip | awk '
      /^Updating / { n++ }
      /No new commits found/ { noop++ }
      /took .* seconds/ { for (i=1; i<=NF; i++) if ($i == "took") { t = $(i+1); break } }
      END {
        new = n - noop
        printf "%d plugins, %d with new commits", n, (new < 0 ? 0 : new)
        if (t) printf " (zi reports %ss)", t
        print ""
      }')
    ;;

  lazy)
    body=$(strip | awk '
      /Finished task fetch/ { fetched++ }
      /^lock-diff: / {
        updated++
        if (updated <= 3) sample = sample (sample ? ", " : "") $2
      }
      /\[ERROR\]|fatal:/ { fail++ }
      END {
        printf "%d fetched, %d updated", fetched, updated
        if (updated) printf " (%s%s)", sample, (updated > 3 ? ", …" : "")
        if (fail) printf "; %d errors", fail
        print ""
      }')
    ;;

  mason)
    body=$(awk '
      /^checked [0-9]+ packages, [0-9]+ outdated/ { checked=$2; outdated=$4 }
      /^[a-z0-9_-]+: .* -> / { upd++; pkg = $1; sub(/:/, "", pkg); samples = samples (samples ? ", " : "") pkg }
      /install failed/ { fail++ }
      /^Error|E5108:/ { lua_err = 1 }
      /attempt to call/ { lua_msg = $0 }
      END {
        if (lua_err) { printf "Lua error: %s\n", lua_msg; exit }
        if (checked == "") { print "no output (script may have failed silently)"; exit }
        printf "%s checked, %s outdated", checked, outdated
        if (upd) printf " (%s)", samples
        if (fail) printf "; %d failed", fail
        print ""
      }')
    ;;

  *)
    body="(no parser for tool: $tool)"
    ;;
esac

# Round delta H:MM:SS.frac → "Ns" (<60s) or "MmSSs" (>=60s)
fmt_delta() {
  local d="$1"
  case "$d" in
    *:*:*)
      local h=${d%%:*} rest=${d#*:}
      local m=${rest%%:*} s=${rest#*:}
      s=${s%.*}
      local total=$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
      if [ "$total" -lt 60 ]; then printf '%ds' "$total"
      else printf '%dm%02ds' $((total / 60)) $((total % 60))
      fi
      ;;
    *) printf '%s' "$d" ;;
  esac
}

# Status escalation: FAIL > body-mentions-warn > OK
status_icon=""
color_reset=$'\033[0m'
color_green=$'\033[32m'
color_yellow=$'\033[33m'
color_red=$'\033[31m'
color_dim=$'\033[2m'

if [ "$status" = "FAIL" ]; then
  icon="✗"; color="$color_red"
elif printf '%s' "$body" | grep -qiE 'aborted|failed|error|warn'; then
  icon="⚠"; color="$color_yellow"
else
  icon="✓"; color="$color_green"
fi

delta_pretty=$(fmt_delta "$delta")
printf '%s%s%s %-7s %s%5s%s  %s\n' "$color" "$icon" "$color_reset" "$tool" "$color_dim" "$delta_pretty" "$color_reset" "$body"
