[user]
	email = nikyasnogorodskyi@gmail.com
	name = Nick Yasnogorodskyi
[core]
	pager = delta 
  sshCommand = "ssh -i ~/.ssh/personal_key -o IdentitiesOnly=yes"
[alias]
  c = checkout
  b = branch
[push]
	default = current
[pull]
	rebase = true
[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false # required for git 2.37.0

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[includeIf "gitdir:~/Documents/commercial/"]
  path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:**/snyk/**"]
  path = ~/.gitconfig-work
# Scoped per-org, not to all of github.com: GOPRIVATE=github.com/snyk means `go mod`
# clones private modules by https URL and needs this rewrite to reach them over ssh.
# A github.com-wide rule also caught Homebrew, whose tap remotes are stored as https,
# so `brew update` failed on every machine without ~/.ssh/personal_key.
[url "ssh://git@github.com/snyk/"]
	insteadOf = https://github.com/snyk/
# The Zscaler bundle exists only on the work Mac, and git aborts every https
# request when http.sslCAInfo names a file that is not there. git ignores a
# missing include, so the dotfiles role writes this file only where the
# bundle is present.
[include]
	path = ~/.gitconfig-zscaler
