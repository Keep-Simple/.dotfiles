.shell "/bin/dash"

# 0x29 maps to ;
# 0x18 maps to =
# 0x2B maps to ,
# 0x1B maps to -

# Command definitions for common patterns
.define unzoom_focus : $YABAI/unzoom.sh; yabai -m window --focus {{1}}
.define unzoom_focus_with_stack : $YABAI/unzoom.sh; yabai -m window --focus {{1}} || yabai -m window --focus stack.{{2}} || yabai -m window --focus stack.{{3}}
.define warp_window : yabai -m window --warp {{1}}
.define resize_window : yabai -m window --resize {{1}} || yabai -m window --resize {{2}}
.define set_layout : yabai -m space --layout {{1}}
.define focus_space : $YABAI/focus_space.sh {{1}}
.define move_to_space : yabai -m window --space {{1}} --focus
.define move_to_space_with_fallback : yabai -m window --space {{1}} --focus || yabai -m window --space {{2}} --focus
.define toggle_window : yabai -m window --toggle {{1}}
.define toggle_window_with_grid : yabai -m window --toggle {{1}} --grid {{2}}
.define toggle_space : yabai -m space --toggle {{1}}

# apps shortcuts
ctrl + alt + cmd - return : open -na Ghostty.app --args --working-directory="${HOME}"
ctrl + alt + cmd + shift - return : yabai -m window --toggle QuickTerminal || open -na Ghostty --args --title=QuickTerminal --working-directory="${HOME}" -e tmux new -A -s quickterm
ctrl + alt + cmd - 0x2B : open -n /System/Applications/System\ Settings.app
ctrl + alt + cmd - b : open -n /Applications/Brave\ Browser.app
# selection screenshot to the clipboard without sound
ctrl + alt + cmd - 0x1B : screencapture -cix /dev/null
# screenshot with options
ctrl + alt + cmd + shift - 0x1B : screencapture -iU /dev/null
ctrl + alt + cmd - 0x18 : @toggle_space("mission-control")
ctrl + alt + cmd - d : killall dmenu-mac; exec dmenu-mac

# change layouts
ctrl + alt + cmd - t : @set_layout("bsp")
ctrl + alt + cmd - u : @set_layout("stack")
ctrl + alt + cmd - y : @set_layout("float")

# focus window
ctrl + alt + cmd - o : @unzoom_focus("recent")
# ctrl + alt + cmd - i : @unzoom_focus("next")
ctrl + alt + cmd - h : @unzoom_focus_with_stack("west", "prev", "last")
ctrl + alt + cmd - j : @unzoom_focus("south")
ctrl + alt + cmd - k : @unzoom_focus("north")
ctrl + alt + cmd - l : @unzoom_focus_with_stack("east", "next", "first")

# warp windows
ctrl + alt + cmd + shift - h : @warp_window("west")
ctrl + alt + cmd + shift - j : @warp_window("south")
ctrl + alt + cmd + shift - k : @warp_window("north")
ctrl + alt + cmd + shift - l : @warp_window("east")

# resize window
ctrl + alt + cmd - left : @resize_window("left:-50:0", "right:-50:0")
ctrl + alt + cmd - down : @resize_window("bottom:0:50", "top:0:50")
ctrl + alt + cmd - up : @resize_window("top:0:-50", "bottom:0:-50")
ctrl + alt + cmd - right : @resize_window("right:50:0", "left:50:0")

# toggle sticky (show on all spaces)
ctrl + alt + cmd + shift - s : @toggle_window("sticky")

# Close active application
ctrl + alt + cmd - q : yabai -m window --close

# toggle window zoom
ctrl + alt + cmd - f : @toggle_window("zoom-fullscreen")

# toggle window native fullscreen
ctrl + alt + cmd + shift - f : @toggle_window("native-fullscreen")

# float / unfloat window
ctrl + alt + cmd + shift - space : @toggle_window_with_grid("float", "4:4:1:1:2:2")

# Restart Yabai
ctrl + alt + cmd - r : pkill -f "title QuickTerminal" 2>/dev/null || true; notify "Restarting yabai..."; if yabai --restart-service; then notify "Restart successful"; else notify "Restart failed"; fi

# focus desktop
ctrl + alt + cmd - 1 : @focus_space("1")
ctrl + alt + cmd - 2 : @focus_space("2")
ctrl + alt + cmd - 3 : @focus_space("3")
ctrl + alt + cmd - 4 : @focus_space("4")
ctrl + alt + cmd - 5 : @focus_space("5")
ctrl + alt + cmd - 6 : @focus_space("6")
ctrl + alt + cmd - 7 : @focus_space("7")
ctrl + alt + cmd - 8 : @focus_space("8")
ctrl + alt + cmd - 9 : @focus_space("9")
ctrl + alt + cmd - g : @focus_space("prev")
ctrl + alt + cmd - 0x29 : @focus_space("next")
ctrl + alt + cmd - p : @focus_space("recent")

# send window to desktop and follow focus
ctrl + alt + cmd + shift - 1 : @move_to_space("1")
ctrl + alt + cmd + shift - 2 : @move_to_space("2")
ctrl + alt + cmd + shift - 3 : @move_to_space("3")
ctrl + alt + cmd + shift - 4 : @move_to_space("4")
ctrl + alt + cmd + shift - 5 : @move_to_space("5")
ctrl + alt + cmd + shift - 6 : @move_to_space("6")
ctrl + alt + cmd + shift - 7 : @move_to_space("7")
ctrl + alt + cmd + shift - 8 : @move_to_space("8")
ctrl + alt + cmd + shift - 9 : @move_to_space("9")
ctrl + alt + cmd + shift - g : @move_to_space_with_fallback("prev", "last")
ctrl + alt + cmd + shift - 0x29 : @move_to_space_with_fallback("next", "first")
ctrl + alt + cmd + shift - p : @move_to_space("recent")
